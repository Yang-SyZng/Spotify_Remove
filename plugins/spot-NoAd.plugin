#!name=Spotify 去广告
#!desc=2026.10.30 修复 bootstrap/customize 二进制响应处理，保留原始客户端配置。更新后重启 Spotify；不保证服务端 Premium 权益。
#!openUrl=https://github.com/Yang-SyZng/Spotify_Remove
# 原项目地址 https://github.com/app2smile/rules
# 功能: 1.去除播放广告 2.歌手/专辑列表正常展示 3.去除随机播放
# forked from @Amlabort

[Rewrite]
# 屏蔽设置界面会员信息及特定服务
^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pendragon - reject-200
^https:\/\/.*-spclient\.spotify\.com(:443)?\/pam-view-service\/ - reject-200
# 屏蔽 AI DJ
^https:\/\/.*37i9dQZF1EYkqdzj48dyYq.* - reject-200

[Script]
# 删除条件缓存请求头（不区分大小写），避免 304 响应跳过脚本
http-request ^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(?:\?.*)?$ script-path=https://raw.githubusercontent.com/Yang-SyZng/Spotify_Remove/main/plugins/js/spotify-customize.js, requires-body=false, timeout=10, tag=SpotifyCache

# bootstrap / customize 响应修改
http-response ^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(?:\?.*)?$ script-path=https://raw.githubusercontent.com/Yang-SyZng/Spotify_Remove/main/plugins/js/spotify-customize.js, requires-body=true, binary-body-mode=true, timeout=10, tag=SpotifyCustomize

# gabo
http-request ^https:\/\/(.*-spclient\.spotify\.com(:443)?|spclient\.wg\.spotify\.com)\/gabo-receiver-service script-path=https://raw.githubusercontent.com/Amlabort/MY_clash/refs/heads/main/files/lpx/js/spot-gabo.js, requires-body=false

# 去搜索广告
http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/browsita\/v.\/browse script-path=https://raw.githubusercontent.com/Amlabort/MY_clash/refs/heads/main/files/lpx/js/spot-NoSearchAd.js, requires-body=true

# 去首页广告
http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/casita\/v.\/home\/default script-path=https://raw.githubusercontent.com/Amlabort/MY_clash/refs/heads/main/files/lpx/js/spot-NoHomeAd.js, requires-body=true

# 去滚动广告
http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/scrollsita\/v.\/scroll\/spotify script-path=https://raw.githubusercontent.com/Amlabort/MY_clash/refs/heads/main/files/lpx/js/spot-NoScrollAd.js, requires-body=true

[MITM]
hostname = spclient.wg.spotify.com, *-spclient.spotify.com
