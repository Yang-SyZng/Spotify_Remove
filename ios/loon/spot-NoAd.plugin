#!name = Spotify 去广告
#!desc = 2026.10.30-r6 增加 Spotify Connect 入口开关和旧版创建按钮兼容选项。修改选项后重启 Spotify；新版创建按钮请在 App 内设置。
#!author = 🐇Gardenia.💙[https://github.com/Yang-SyZng]
#!homepage = https://apps.apple.com/app/id324684580
#!icon = https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/8b/f2/6a/8bf26ab9-3ced-cb5c-a2b3-19f65e7f5cc6/AppIcon-0-0-1x_U007epad-0-1-0-0-85-220.png/512x512bb.jpg
#!date = 2026-10-30

[Argument]
createButton = select,跟随App,隐藏,显示,tag=创建按钮（旧版兼容）,desc=仅处理已有的旧版导航实验；新版请在 Spotify 的内容和显示中设置创建按钮
connectEnabled = switch,true,tag=Spotify Connect 入口,desc=控制切换播放设备的入口；不会断开已有会话或改变服务端权限；修改后重启 Spotify

[Rewrite]
# 屏蔽设置界面会员信息及特定服务
^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pendragon - reject-200
^https:\/\/.*-spclient\.spotify\.com(:443)?\/pam-view-service\/ - reject-200
# 屏蔽 AI DJ
^https:\/\/.*37i9dQZF1EYkqdzj48dyYq.* - reject-200

[Script]
# 删除条件缓存请求头（不区分大小写），避免 304 响应跳过脚本
http-request ^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(?:\?.*)?$ script-path=https://raw.githubusercontent.com/Yang-SyZng/plugin-hub/main/ios/js/spotify/spotify-customize.js, requires-body=false, timeout=10, tag=SpotifyCache

# bootstrap / customize 响应修改
http-response ^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(?:\?.*)?$ script-path=https://raw.githubusercontent.com/Yang-SyZng/plugin-hub/main/ios/js/spotify/spotify-customize.js, requires-body=true, binary-body-mode=true, argument={createButton,connectEnabled}, timeout=10, tag=SpotifyCustomize

# gabo
http-request ^https:\/\/(.*-spclient\.spotify\.com(:443)?|spclient\.wg\.spotify\.com)\/gabo-receiver-service script-path=https://raw.githubusercontent.com/Amlabort/MY_clash/refs/heads/main/files/lpx/js/spot-gabo.js, requires-body=false

# 搜索、首页、滚动页面原样返回。
# 旧广告脚本会回写文本或扫描任意字节修改 protobuf，可能导致页面“出错了”。

[MITM]
hostname = spclient.wg.spotify.com, *-spclient.spotify.com
